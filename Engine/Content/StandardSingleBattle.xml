  <Loadouts>
    <!-- 初始构筑：无遗物、无牌型升级；牌库固定为标准52张，发牌由宿主种子洗牌。
         可将模板加入本节点，例如：<Relic instanceId="first-relic" ref="straight-dot"/>
         子节点从上到下就是获得顺序；无须修改牌型或 Unity 代码。 -->
    <Loadout id="baseline" name="标准初始构筑·无遗物" deckRef="standard-deck"/>
  </Loadouts>
  <Encounters>
    <Encounter id="standard-single-battle" name="标准单对局" rulesRef="single-battle-rules">
      <Player id="player" ref="hero" loadoutRef="baseline"/>
      <Enemy id="enemy" ref="guardian"/>
    </Encounter>
  </Encounters>
</BattleContent>
