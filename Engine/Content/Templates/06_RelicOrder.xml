<?xml version="1.0" encoding="utf-8"?>
<BattleContent schemaVersion="1" id="relic-order-content" name="炼金顺序试验" version="relic-order.1">
  <!--玩法：每次高牌固定100基础伤害。两个编成仅交换获得顺序，对照先加20再乘1.5=180与先乘1.5再加20=170。修改的是伤害，不是计分倍率。 所有数值为玩法实验值，可直接修改；不代表策划定案。-->
  <ScoringProfiles>
    <Scoring id="single-battle-score" name="标准计分·倍率待定" version="score.standard-single-battle.1">
      <Hand category="HighCard" points="0" multiplier="1" pointsPerLevel="0" multiplierPerLevel="1" />
      <Hand category="OnePair" points="0" multiplier="2" pointsPerLevel="0" multiplierPerLevel="1" />
      <Hand category="TwoPair" points="0" multiplier="2" pointsPerLevel="0" multiplierPerLevel="1" />
      <Hand category="ThreeOfAKind" points="0" multiplier="3" pointsPerLevel="0" multiplierPerLevel="2" />
      <Hand category="Straight" points="0" multiplier="4" pointsPerLevel="0" multiplierPerLevel="3" />
      <Hand category="Flush" points="0" multiplier="4" pointsPerLevel="0" multiplierPerLevel="2" />
      <Hand category="FullHouse" points="0" multiplier="4" pointsPerLevel="0" multiplierPerLevel="2" />
      <Hand category="FourOfAKind" points="0" multiplier="7" pointsPerLevel="0" multiplierPerLevel="3" />
      <Hand category="StraightFlush" points="0" multiplier="8" pointsPerLevel="0" multiplierPerLevel="4" />
      <Hand category="FiveOfAKind" points="0" multiplier="12" pointsPerLevel="0" multiplierPerLevel="3" />
      <CardPoints>
        <Rank rank="Two" points="2" />
        <Rank rank="Three" points="3" />
        <Rank rank="Four" points="4" />
        <Rank rank="Five" points="5" />
        <Rank rank="Six" points="6" />
        <Rank rank="Seven" points="7" />
        <Rank rank="Eight" points="8" />
        <Rank rank="Nine" points="9" />
        <Rank rank="Ten" points="10" />
        <Rank rank="Jack" points="10" />
        <Rank rank="Queen" points="10" />
        <Rank rank="King" points="10" />
        <Rank rank="Ace" points="11" />
      </CardPoints>
    </Scoring>
  </ScoringProfiles>
  <BattleRules>
    <Rules id="single-battle-rules" name="模板公共规则" scoringRef="single-battle-score" roundLimit="16" blockExpiry="AfterEnemyPhase" maxReactionEffects="256" maxReactionDepth="16" />
  </BattleRules>
  <Statuses>
    <Status id="stun" name="眩晕·跳过一次行动窗口" tags="Control" lifetime="TriggerCount" count="1">
      <BlockActionWindow />
    </Status>
    <Status id="control-immunity" name="控制免疫·至下个敌方阶段结束" lifetime="ThroughNextPhase" phase="enemy">
      <PreventStatusApplication tags="Control" />
    </Status>
    <Status id="bleed" tags="Negative" name="流血·行动后2伤共2次" lifetime="TriggerCount" count="2" reapply="IndependentInstances">
      <PeriodicDamage timing="ActionCompleted" amount="2" target="Self" />
    </Status>
    <Status id="poison" tags="Negative" name="中毒·己方阶段末2伤共2次" lifetime="TriggerCount" count="2" reapply="IndependentInstances">
      <PeriodicDamage timing="PhaseEnding" amount="2" target="Self" />
    </Status>
    <Status id="shield-reflect" name="盾反·按实际格挡等额反伤" lifetime="UntilRemoved">
      <ReflectBlockedDamage ratio="1" target="EventSource" />
    </Status>
    <Status id="overheal-damage" name="溢出治疗等额转单体伤害" lifetime="UntilRemoved">
      <OverhealDamage ratio="1" target="Opponents" selection="FirstLiving" />
    </Status>
    <Status id="life-steal" name="吸血·实际伤害20%" lifetime="UntilRemoved">
      <LifeSteal ratio="0.2" target="Self" />
    </Status>
  </Statuses>
  <HandRules>
    <HandRule id="document-hands" name="炼金顺序试验·牌型技能" version="relic-order.hands.1">
      <Hand category="HighCard">
        <Effect kind="Damage" id="damage/1" amount="100" target="Opponents" selection="FirstLiving" />
      </Hand>
      <Hand category="OnePair">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="FirstLiving" />
      </Hand>
      <Hand category="TwoPair">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="FirstLiving" />
      </Hand>
      <Hand category="ThreeOfAKind">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="AllLiving" />
      </Hand>
      <Hand category="Straight">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="0.35" target="Opponents" selection="FirstLiving" />
        <Effect id="damage/2" kind="Damage" amountKind="ScoreTotalScale" amount="0.35" target="Opponents" selection="FirstLiving" />
        <Effect id="damage/3" kind="Damage" amountKind="ScoreTotalScale" amount="0.35" target="Opponents" selection="FirstLiving" />
      </Hand>
      <Hand category="Flush">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="FirstLiving" />
        <Effect id="heal" kind="Heal" amountKind="ScorePointsScale" amount="0.2" target="Self" />
      </Hand>
      <Hand category="FullHouse">
        <Effect id="stun" kind="ApplyStatus" statusRef="stun" target="Opponents" selection="FirstLiving" />
        <Effect id="cleanse" kind="Cleanse" target="Self" />
        <Effect id="control-immunity" kind="ApplyStatus" statusRef="control-immunity" target="Self" />
      </Hand>
      <Hand category="FourOfAKind">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="AllLiving" />
      </Hand>
      <Hand category="StraightFlush" variant="Ordinary">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="FirstLiving" />
      </Hand>
      <Hand category="StraightFlush" variant="Royal">
        <Effect id="eliminate" kind="Eliminate" target="Opponents" selection="AllLiving" />
      </Hand>
      <Hand category="FiveOfAKind">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="FirstLiving" />
      </Hand>
    </HandRule>
  </HandRules>
  <Relics>
    <Relic id="flat-stone" name="赤石·主动伤害加20" version="flat-stone.1">
      <Numeric id="flat" stat="DamageDealt" operation="AddFlat" value="20" origins="Primary" />
    </Relic>
    <Relic id="rate-lens" name="透镜·主动伤害乘1.5" version="rate-lens.1">
      <Numeric id="rate" stat="DamageDealt" operation="AddRate" value="0.5" origins="Primary" />
    </Relic>
  </Relics>
  <Players>
    <Player id="hero" name="炼金顺序试验·玩家" maxHealth="240" initialBlock="0" handRuleRef="document-hands" maxEnergy="3" initialEnergy="3" playEnergyCost="1" discardEnergyCost="1" handSize="8" discards="6" unlimitedDiscards="false" maxPlayCards="5" maxDiscardCards="5" playRefill="AfterAction" discardRefill="AfterAction" discardBlockPerCard="6" />
  </Players>
  <Enemies>
    <Enemy id="golem" name="炼金傀儡" maxHealth="1000" damage="30" />
  </Enemies>
  <Decks>
    <Deck id="order-deck" name="14张顺序试验牌">
      <Card id="order-deck-01" face="standard:1:2" />
      <Card id="order-deck-02" face="standard:1:4" />
      <Card id="order-deck-03" face="standard:1:6" />
      <Card id="order-deck-04" face="standard:1:8" />
      <Card id="order-deck-05" face="standard:1:10" />
      <Card id="order-deck-06" face="standard:1:12" />
      <Card id="order-deck-07" face="standard:1:14" />
      <Card id="order-deck-08" face="standard:2:2" />
      <Card id="order-deck-09" face="standard:2:4" />
      <Card id="order-deck-10" face="standard:2:6" />
      <Card id="order-deck-11" face="standard:2:8" />
      <Card id="order-deck-12" face="standard:2:10" />
      <Card id="order-deck-13" face="standard:2:12" />
      <Card id="order-deck-14" face="standard:2:14" />
    </Deck>
  </Decks>
  <Loadouts>
    <Loadout id="flat-then-rate" deckRef="order-deck">
      <Relic instanceId="acquired-01" ref="flat-stone" />
      <Relic instanceId="acquired-02" ref="rate-lens" />
    </Loadout>
    <Loadout id="rate-then-flat" deckRef="order-deck">
      <Relic instanceId="acquired-01" ref="rate-lens" />
      <Relic instanceId="acquired-02" ref="flat-stone" />
    </Loadout>
  </Loadouts>
  <Encounters>
    <Encounter id="flat-then-rate" name="先赤石后透镜·高牌180" rulesRef="single-battle-rules">
      <Player id="player" ref="hero" loadoutRef="flat-then-rate" />
      <Enemy id="enemy-1" ref="golem" />
    </Encounter>
    <Encounter id="rate-then-flat" name="先透镜后赤石·高牌170" rulesRef="single-battle-rules">
      <Player id="player" ref="hero" loadoutRef="rate-then-flat" />
      <Enemy id="enemy-1" ref="golem" />
    </Encounter>
  </Encounters>
</BattleContent>
