  <BattleRules>
    <Rules id="single-battle-rules" name="标准单局规则·20回合后狂暴" scoringRef="single-battle-score" roundLimit="20" roundLimitBehavior="Enrage" enrageDamagePerRound="20" clearEnemyBlock="true" blockExpiry="AfterEnemyPhase" maxReactionEffects="256" maxReactionDepth="16" />
  </BattleRules>
  <Statuses>
    <Status id="stun" name="眩晕·跳过一次行动窗口" tags="Control" lifetime="TriggerCount" count="1">
      <BlockActionWindow />
    </Status>
    <Status id="control-immunity" name="控制免疫·至下个敌方阶段结束" lifetime="ThroughNextPhase" phase="enemy">
      <PreventStatusApplication tags="Control" />
    </Status>
    <Status id="bleed" tags="Negative" name="中毒·按层数伤害并衰减" lifetime="UntilRemoved" reapply="AddStacks">
      <PeriodicDamage timing="TurnStarted" timingSubject="Holder" amount="1" target="Self" stackDecay="1" />
    </Status>
    <Status id="shield-reflect" name="盾反·按实际格挡等额反伤" lifetime="UntilRemoved">
      <ReflectBlockedDamage ratio="1" target="EventSource" />
    </Status>
    <Status id="overheal-damage" name="溢出治疗等额转单体伤害" lifetime="UntilRemoved">
      <OverhealDamage ratio="1" target="Opponents" selection="FirstLiving" />
    </Status>
    <Status id="life-steal" name="吸血·实际伤害20%" lifetime="UntilRemoved">
      <LifeSteal ratio="0.2" target="Self" />
    </Status>
    <Status id="layer-armor" name="多段击破护甲" lifetime="UntilRemoved">
      <HitArmor multiplier="0.25" consumeStacks="1" primaryOnly="true" />
    </Status>
  </Statuses>
  <HandRules>
    <HandRule id="document-hands" name="策划牌型技能" version="document-hands.standard.3" combineCompatibleEffects="true">
      <Hand category="HighCard">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="ActorPolicy" />
      </Hand>
      <Hand category="OnePair">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="ActorPolicy" />
      </Hand>
      <Hand category="TwoPair">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="ActorPolicy" />
      </Hand>
      <Hand category="ThreeOfAKind">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="AllLiving" />
      </Hand>
      <Hand category="Straight">
        <!--每张实际出牌各打一次：本牌计分筹码 × 最高牌型倍率；每次命中立刻加1层毒。遗物缩短顺子时，段数随张数缩短。-->
        <Effect id="damage/1" kind="Damage" amountKind="CardScoreScale" amount="1" perSubmittedCard="true" target="Opponents" selection="ActorPolicy" retargetChain="straight">
          <OnHitStatus statusRef="bleed" stacks="1" />
        </Effect>
      </Hand>
      <Hand category="Flush">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="ActorPolicy" />
      </Hand>
      <Hand category="FullHouse">
        <!--按最高牌型统一计分；三条群攻与葫芦控制机制叠加，不再额外结算对子伤害。-->
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="AllLiving" />
        <Effect id="stun" kind="ApplyStatus" statusRef="stun" target="Opponents" selection="ActorPolicy" />
        <Effect id="cleanse" kind="Cleanse" target="Self" />
        <Effect id="control-immunity" kind="ApplyStatus" statusRef="control-immunity" target="Self" />
      </Hand>
      <Hand category="FourOfAKind">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="AllLiving" />
      </Hand>
      <Hand category="StraightFlush" variant="Ordinary">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="ActorPolicy" />
      </Hand>
      <Hand category="StraightFlush" variant="Royal">
        <Effect id="eliminate" kind="Eliminate" target="Opponents" selection="AllLiving" />
      </Hand>
      <Hand category="FiveOfAKind">
        <Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents" selection="ActorPolicy" />
      </Hand>
      <!--同花独立回血：所有有效出牌筹码 × 同花一级基础倍率 × 20%；伤害使用最高牌型计分，兼容机制分别触发。皇家同花顺保留强制消灭。-->
      <FlushBonus>
        <Effect id="heal" kind="Heal" amountKind="FlushBaseTotalScale" amount="0.2" target="Self" />
      </FlushBonus>
    </HandRule>
  </HandRules>
  <Relics>
    <Relic id="straight-dot" name="模板·顺子额外中毒" version="straight-dot.template.1">
      <FactTrigger id="bleed-per-hit" timing="DamageSettled" relation="OwnerIsSource" occurrence="PerEvent" origins="Primary">
        <Conditions>
          <HandIs category="Straight" />
        </Conditions>
        <Effect kind="ApplyStatus" statusRef="bleed" target="EventTarget" stacks="1" />
      </FactTrigger>
    </Relic>
    <Relic id="discard-reflect" name="模板·弃牌盾反" version="discard-reflect.template.1">
      <BoundaryTrigger id="opening-reflect" timing="BattleStarted">
        <Effect kind="ApplyStatus" statusRef="shield-reflect" target="Self" />
      </BoundaryTrigger>
    </Relic>
    <Relic id="flush-overheal" name="模板·同花治疗与溢疗转伤" version="flush-overheal.template.1">
      <Numeric id="flush-heal-rate" stat="HealingDone" operation="AddRate" value="0.5" origins="Primary" hand="Flush" />
      <BoundaryTrigger id="opening-overheal" timing="BattleStarted">
        <Effect kind="ApplyStatus" statusRef="overheal-damage" target="Self" />
      </BoundaryTrigger>
    </Relic>
  </Relics>
  <Players>
    <Player id="hero" name="玩家" maxHealth="800" initialBlock="0" handRuleRef="document-hands" maxEnergy="3" initialEnergy="3" playEnergyCost="1" discardEnergyCost="1" handSize="8" discards="3" unlimitedDiscards="true" maxPlayCards="5" maxDiscardCards="52" playRefill="NextPlayerTurn" discardRefill="NextPlayerTurn" manualDraw="true" openingDeal="true" drawCount="5" drawUses="1" drawWarningThreshold="3" minPlayCards="1" actionsPerTurn="3" effectDrawOverflow="true" discardEndsTurn="true" discardCostsAction="true" endDefense="false" overflowTriggersDefense="true" kickerScoring="None" minFlushCards="3" minStraightCards="5" layeredScoreRelics="true" discardBlockPerPoint="1" attackTarget="LowestHealth" />
