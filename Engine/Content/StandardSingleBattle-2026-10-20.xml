<?xml version="1.0" encoding="utf-8"?>
<BattleContent schemaVersion="1" id="standard-single-battle-2026-10-20" name="标准单对局·2026-10-20·三种怪物" version="standard-single-battle.2026-10-20.1">
  <!--策划 revision 1582：开局8张，主动摸牌一次至多5张，3次行动；短同花3至5张，踢脚牌不计分。主动防御后结束，不追加结束防御；超限弃牌触发防御。第20回合结束进入狂暴，每回合追加20伤害为待数值确认的测试值。三个默认怪物共用标准玩家和卡组。-->
  <!--2026-10-20 确认补充：按最高牌型统一计伤，兼容的逐张攻击、群攻、中毒、治疗、控制和净化机制叠加；基础伤害不重复。-->
  <!--2026-10-20 日期版：本次核对策划 revision 1690 的毒素口径，默认中毒者回合开始结算。PeriodicDamage.timingSubject 可选 Holder（中毒者）或 Applier（施加者）；timing 可选 TurnStarted（回合开始）、ActionCompleted（有效行动后）、PhaseEnding（所属阵营阶段结束）；每层伤害 amount 与衰减层数 stackDecay 独立配置。其余规则沿用当前标准版及用户明确补充。-->
  <ScoringProfiles>
    <Scoring id="single-battle-score" name="标准计分·倍率待定" version="score.standard-single-battle.1">
      <Hand category="HighCard" points="0" multiplier="1" pointsPerLevel="0" multiplierPerLevel="1" />
