  <Enemies>
    <Enemy id="rotator" name="轮换小怪" maxHealth="600">
      <Behavior consumeFailedSummon="false">
        <Stage id="normal" mode="Sequence">
          <Action id="jab" name="试探攻击">
            <Effects>
              <Effect id="hit" kind="Damage" amount="40" />
            </Effects>
          </Action>
          <Action id="strike" name="重击">
            <Effects>
              <Effect id="hit" kind="Damage" amount="70" />
            </Effects>
          </Action>
          <Action id="guard" name="防御">
            <Effects>
              <Effect id="block" kind="GainBlock" amount="90" target="Self" />
            </Effects>
          </Action>
        </Stage>
      </Behavior>
    </Enemy>
    <Enemy id="summoner" name="护甲召唤精英" maxHealth="1800">
      <Behavior consumeFailedSummon="false">
        <OpeningEffects>
          <Effect id="armor" kind="ApplyStatus" statusRef="layer-armor" stacks="3" target="Self" />
        </OpeningEffects>
        <Stage id="normal" mode="Priority">
          <Action id="summon" name="召唤护卫" cooldownRounds="1">
            <When kind="AlliesBelow" value="2" />
            <Summon enemyRef="rotator" count="2" livingLimit="3" limitScope="Summoner" />
          </Action>
          <Action id="strike" name="震击">
            <Effects>
              <Effect id="hit" kind="Damage" amount="90" target="Opponents" selection="AllLiving" />
            </Effects>
          </Action>
        </Stage>
      </Behavior>
    </Enemy>
    <Enemy id="gluttony" name="暴食Boss" maxHealth="2400">
      <Behavior seed="17" intentPreviewTurns="8" refreshOnHealthThreshold="true" consumeFailedSummon="false">
        <Stage id="hungry" mode="Sequence">
          <When kind="HealthAtMost" value="0.5" />
          <Action id="devour" name="暴食：重击并塞入三张废牌">
            <Effects>
              <Effect id="hit" kind="Damage" amount="120" />
            </Effects>
            <AddCards face="standard:1:2" count="3" zone="discard" disabled="false" effects="Ineffective,Unplayable" />
          </Action>
        </Stage>
        <Stage id="normal" mode="Sequence">
          <Action id="pollute" name="吞食：攻击并塞入一张废牌">
            <Effects>
              <Effect id="hit" kind="Damage" amount="60" />
            </Effects>
            <AddCards face="standard:1:2" count="1" zone="discard" disabled="false" effects="Ineffective,Unplayable" />
          </Action>
        </Stage>
      </Behavior>
    </Enemy>
  </Enemies>
