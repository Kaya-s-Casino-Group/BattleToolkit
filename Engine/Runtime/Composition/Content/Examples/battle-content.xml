<?xml version="1.0" encoding="utf-8"?>
<!-- 可执行格式示例，不代表正式平衡数值，不会自动替换现有 SO。 -->
<BattleContent schemaVersion="1" id="content-example" version="1">
  <ScoringProfiles><Scoring id="standard-score" preset="Default"/></ScoringProfiles>
  <BattleRules><Rules id="standard-battle" scoringRef="standard-score" roundLimit="20" blockExpiry="Retain"/></BattleRules>
  <Statuses>
    <Status id="stun" tags="Control" lifetime="TriggerCount" count="1"><BlockActionWindow/></Status>
    <Status id="control-immunity" lifetime="ThroughNextPhase" phase="enemy"><PreventStatusApplication tags="Control"/></Status>
    <Status id="bleed" lifetime="TriggerCount" count="2"><PeriodicDamage timing="ActionCompleted" amount="2" target="Self"/></Status>
  </Statuses>
  <HandRules>
    <HandRule id="example-hands">
      <Hand category="HighCard"><Effect id="damage/1" kind="Damage" amountKind="ScoreTotalScale" amount="1" target="Opponents"/></Hand>
      <Hand category="OnePair"><Effect id="damage/1" kind="Damage" amount="10" target="Opponents"/></Hand>
      <Hand category="TwoPair"><Effect id="damage/1" kind="Damage" amount="10" target="Opponents"/></Hand>
      <Hand category="ThreeOfAKind"><Effect id="heal/1" kind="Heal" amount="5" target="Self"/></Hand>
      <Hand category="Straight"><Effect id="damage/1" kind="Damage" amount="10" target="Opponents" selection="AllLiving"/></Hand>
      <Hand category="Flush"><Effect id="block/1" kind="GainBlock" amount="5" target="Self"/></Hand>
      <Hand category="FullHouse">
        <Effect id="stun/1" kind="ApplyStatus" statusRef="stun" target="Opponents"/>
        <Effect id="immunity/1" kind="ApplyStatus" statusRef="control-immunity" target="Self"/>
      </Hand>
      <Hand category="FourOfAKind"><Effect id="bleed/1" kind="ApplyStatus" statusRef="bleed" target="Opponents"/></Hand>
      <Hand category="StraightFlush" variant="Ordinary"><Effect id="damage/1" kind="Damage" amount="20" target="Opponents"/></Hand>
      <Hand category="StraightFlush" variant="Royal"><Effect id="eliminate/1" kind="Eliminate" target="Opponents"/></Hand>
      <Hand category="FiveOfAKind"><Effect id="damage/1" kind="Damage" amount="20" target="Opponents"/></Hand>
    </HandRule>
  </HandRules>
  <Relics>
    <Relic id="example-relic" charges="3">
      <Numeric id="damage-flat" stat="DamageDealt" operation="AddFlat" value="2" origins="Primary"/>
      <HandModifier id="pair-extra-hit" category="OnePair" operation="AddHits" stepId="damage/1" hits="1"/>
      <RuleValue id="extra-energy" key="MaxEnergy" delta="1"/>
      <Budget maxUsesPerAction="1" chargeCost="1"/>
      <ActionTrigger id="discard-block" timing="DiscardCompleted" relation="OwnerIsActor">
        <Effect kind="GainBlock" amount="1" target="EventActor"/>
      </ActionTrigger>
    </Relic>
  </Relics>
  <Players><Player id="hero" maxHealth="100" handRuleRef="example-hands" handSize="8" initialEnergy="3" maxEnergy="3"/></Players>
  <Enemies><Enemy id="guard" maxHealth="100" damage="7"/></Enemies>
  <Decks>
    <Deck id="small-deck">
      <Card id="c1" face="standard:1:2"/><Card id="c2" face="standard:1:3"/>
      <Card id="c3" face="standard:1:4"/><Card id="c4" face="standard:1:5"/>
      <Card id="c5" face="standard:1:6"/><Card id="c6" face="standard:1:7"/>
      <Card id="c7" face="standard:1:8"/><Card id="c8" face="standard:1:9"/>
    </Deck>
  </Decks>
  <Loadouts><Loadout id="example-build" deckRef="small-deck">
    <Relic instanceId="starter" ref="example-relic" level="1"/>
    <HandLevel category="HighCard" level="2"/>
  </Loadout></Loadouts>
  <Encounters><Encounter id="example-fight" rulesRef="standard-battle">
    <Player id="p" ref="hero" loadoutRef="example-build" initialHealth="80"/>
    <Enemy id="e" ref="guard"/>
  </Encounter></Encounters>
</BattleContent>
